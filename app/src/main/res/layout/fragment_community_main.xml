<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rallyPlaceContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_weight="1"
                android:text="커뮤니티"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="10dp">

                <ImageView
                    android:id="@+id/notification_iv"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:src="@drawable/notification_icon"
                    android:visibility="visible" />

                <ImageView
                    android:id="@+id/notification_with_badge_iv"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:src="@drawable/notification_badge_icon"
                    android:visibility="gone" />

            </FrameLayout>

        </LinearLayout>


        <EditText
            android:id="@+id/searchTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="15dp"
            android:layout_marginTop="34.5dp"
            android:background="@drawable/search_bar_border"
            android:drawableEnd="@drawable/search_icon"
            android:hint="검색어를 입력해주세요."
            android:inputType="text"
            android:letterSpacing="0.06"
            android:maxLines="1"
            android:paddingVertical="12dp"
            android:paddingStart="27dp"
            android:paddingEnd="13.67dp"
            android:textColor="@color/black"
            android:textColorHint="@color/gray"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_marginTop="42.47dp"
            android:text="오늘의 화제글 🔥"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/freeBoard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="25dp"
                android:text="자유게시판"
                android:textColor="@color/main"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/rallyCertification"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="17.47dp"
                android:layout_marginTop="25dp"
                android:text="성지순례인증"
                android:textColor="@color/gray"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="15dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/community_main_articlelist_background"
            android:orientation="vertical"
            android:paddingHorizontal="18.8dp"
            android:paddingVertical="13.19dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:background="@drawable/comminity_main_article_background"
                android:orientation="horizontal"
                android:paddingStart="10.21dp"
                android:paddingTop="9.51dp"
                android:paddingEnd="8.77dp"
                android:paddingBottom="7.56dp">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_gravity="center"
                    android:layout_marginEnd="14.65dp"
                    android:src="@drawable/community_main_black_number_1" />

                <TextView
                    android:id="@+id/topic_today_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="@color/black"
                    android:textSize="17sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:background="@drawable/comminity_main_article_background"
                android:orientation="horizontal"
                android:paddingStart="10.21dp"
                android:paddingTop="9.51dp"
                android:paddingEnd="8.77dp"
                android:paddingBottom="7.56dp">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_gravity="center"
                    android:layout_marginEnd="14.65dp"
                    android:src="@drawable/community_main_black_number_2" />

                <TextView
                    android:id="@+id/topic_today_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="@color/black"
                    android:textSize="17sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:background="@drawable/comminity_main_article_background"
                android:orientation="horizontal"
                android:paddingStart="10.21dp"
                android:paddingTop="9.51dp"
                android:paddingEnd="8.77dp"
                android:paddingBottom="7.56dp">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_gravity="center"
                    android:layout_marginEnd="14.65dp"
                    android:src="@drawable/community_main_black_number_3" />

                <TextView
                    android:id="@+id/topic_today_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="@color/black"
                    android:textSize="17sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:background="@drawable/comminity_main_article_background"
                android:orientation="horizontal"
                android:paddingStart="10.21dp"
                android:paddingTop="9.51dp"
                android:paddingEnd="8.77dp"
                android:paddingBottom="7.56dp">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_gravity="center"
                    android:layout_marginEnd="14.65dp"
                    android:src="@drawable/community_main_black_number_4" />

                <TextView
                    android:id="@+id/topic_today_4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="@color/black"
                    android:textSize="17sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/comminity_main_article_background"
                android:orientation="horizontal"
                android:paddingStart="10.21dp"
                android:paddingTop="9.51dp"
                android:paddingEnd="8.77dp"
                android:paddingBottom="7.56dp">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_gravity="center"
                    android:layout_marginEnd="14.65dp"
                    android:src="@drawable/community_main_black_number_5" />

                <TextView
                    android:id="@+id/topic_today_5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="@color/black"
                    android:textSize="17sp" />
            </LinearLayout>


        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:id="@+id/community_free_blackBox_cl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="15dp"
            android:layout_marginTop="50dp"
            android:background="@drawable/rounded_black_background"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:padding="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/animationRally_blackBox_cl">

            <TextView
                android:id="@+id/community_free_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="30dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:text="자유게시판"
                android:textColor="@color/white"
                android:textSize="23sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- 사진 -->
            <ImageView
                android:id="@+id/community_free_photo_iv"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_marginEnd="20dp"
                android:scaleType="centerCrop"
                android:src="@drawable/write_ic"
                app:layout_constraintBottom_toBottomOf="@id/community_free_blackBox_cl"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/community_free_blackBox_cl" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:id="@+id/community_rally_pinkBox_cl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="15dp"
            android:layout_marginTop="25dp"
            android:background="@drawable/rounded_pink_background"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:padding="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/animationRally_blackBox_cl">

            <TextView
                android:id="@+id/community_rally_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="30dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:text="성지순례 인증"
                android:textColor="@color/white"
                android:textSize="23sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- 사진 -->
            <ImageView
                android:id="@+id/community_rally_photo_iv"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_marginEnd="20dp"
                android:scaleType="centerCrop"
                android:src="@drawable/map_ic"
                app:layout_constraintBottom_toBottomOf="@id/community_rally_pinkBox_cl"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/community_rally_pinkBox_cl" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_marginTop="50dp"
            android:text="월간 화제글 👑"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="15dp"
            android:layout_marginTop="10.28dp"
            android:layout_marginBottom="180dp"
            android:background="@drawable/community_main_articlelist_background"
            android:orientation="vertical"
            android:paddingHorizontal="18.8dp"
            android:paddingVertical="13.19dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="25dp"
                android:background="@drawable/comminity_main_article_background"
                android:orientation="horizontal"
                android:paddingStart="10.21dp"
                android:paddingTop="9.51dp"
                android:paddingEnd="8.77dp"
                android:paddingBottom="7.56dp">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_gravity="center"
                    android:layout_marginEnd="14.65dp"
                    android:src="@drawable/community_main_pink_number_1" />

                <TextView
                    android:id="@+id/topic_monthly_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="나고야 주변 성지순례 리스트 모음집.zip"
                    android:textColor="@color/black"
                    android:textSize="17sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="25dp"
                android:background="@drawable/comminity_main_article_background"
                android:orientation="horizontal"
                android:paddingStart="10.21dp"
                android:paddingTop="9.51dp"
                android:paddingEnd="8.77dp"
                android:paddingBottom="7.56dp">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_gravity="center"
                    android:layout_marginEnd="14.65dp"
                    android:src="@drawable/community_main_pink_number_2" />

                <TextView
                    android:id="@+id/topic_monthly_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="날씨의아이 성지순례 언제 가는게 좋은지 추천 해주세요"
                    android:textColor="@color/black"
                    android:textSize="17sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:background="@drawable/comminity_main_article_background"
                android:orientation="horizontal"
                android:paddingStart="10.21dp"
                android:paddingTop="9.51dp"
                android:paddingEnd="8.77dp"
                android:paddingBottom="7.56dp">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_gravity="center"
                    android:layout_marginEnd="14.65dp"
                    android:src="@drawable/community_main_pink_number_3" />

                <TextView
                    android:id="@+id/topic_monthly_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="8월 말 도쿄타워 투어하고 주변 다니면서 성지순례 한 후기"
                    android:textColor="@color/black"
                    android:textSize="17sp" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>


</ScrollView>